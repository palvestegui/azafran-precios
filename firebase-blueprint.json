{
  "entities": {
    "GlobalConfig": {
      "title": "Global Configuration",
      "description": "System-wide materials, products, regular expenses, daily expenses, staff, and profit margins.",
      "type": "object",
      "properties": {
        "materials": { "type": "array" },
        "products": { "type": "array" },
        "regularPayments": { "type": "array" },
        "dailyExpenses": { "type": "array" },
        "staff": { "type": "array" },
        "profitMargin": { "type": "number" },
        "wholesaleMargin": { "type": "number" },
        "productionCapacity": { "type": "number" }
      },
      "required": ["materials", "products", "regularPayments", "dailyExpenses", "staff", "profitMargin", "productionCapacity"]
    },
    "PricingAudit": {
      "title": "Pricing Audit",
      "description": "A complete pricing audit for a product unit.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string", "enum": ["Azafrán"] },
        "description": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "completed"] },
        "userId": { "type": "string" },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "quantity": { "type": "number" },
              "unit": { "type": "string" },
              "costPerUnit": { "type": "number" },
              "totalCost": { "type": "number" }
            }
          }
        },
        "totalMaterialsCost": { "type": "number" },
        "labor": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "task": { "type": "string" },
              "hours": { "type": "number" },
              "hourlyRate": { "type": "number" },
              "totalCost": { "type": "number" }
            }
          }
        },
        "totalLaborCost": { "type": "number" },
        "indirectCosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "cost": { "type": "number" }
            }
          }
        },
        "totalIndirectCosts": { "type": "number" },
        "extras": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "cost": { "type": "number" }
            }
          }
        },
        "totalExtrasCost": { "type": "number" },
        "floorPrice": { "type": "number" },
        "profitMargin": { "type": "number" },
        "suggestedPrice": { "type": "number" }
      },
      "required": ["name", "brand", "userId", "createdAt", "updatedAt", "status", "floorPrice", "suggestedPrice"]
    },
    "PricingSnapshot": {
      "title": "Pricing Snapshot",
      "description": "Global calculated pricing matrix and catalog snapshots for Ventas synchronization.",
      "type": "object",
      "properties": {
        "garments": { "type": "object" },
        "catalogGarments": { "type": "object" },
        "catalog": { "type": "object" },
        "lastSyncedAt": { "type": "number" },
        "updatedAt": { "type": "string" },
        "publishedBy": { "type": "string" }
      },
      "required": ["garments", "catalogGarments", "lastSyncedAt", "updatedAt"]
    }
  },
  "firestore": {
    "config/{configId}": {
      "schema": "GlobalConfig",
      "description": "Global price and rate settings."
    },
    "audits/{auditId}": {
      "schema": "PricingAudit",
      "description": "Collection of pricing audits."
    },
    "pricing/{pricingId}": {
      "schema": "PricingSnapshot",
      "description": "Published pricing matrix and catalog snapshots."
    }
  }
}
